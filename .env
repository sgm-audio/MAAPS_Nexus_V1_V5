# MAAPS Nexus V1-V5 Environment Configuration
# Copy to .env and fill in values

# Database
POSTGRES_USER=maaps_admin
POSTGRES_PASSWORD=change_me_in_production

# GitHub CI/CD (V1)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# HeartMuLa API (if using cloud)
HEARTMULA_API_KEY=
HEARTMULA_API_URL=

# ElevenLabs (Voice Cloning for V2)
ELEVENLABS_API_KEY=

# Email SMTP (V2 Outbound)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Network Drive (V3 Audio Export)
SGM_STUDIOS_PATH=/mnt/sgm_studios

# Timezone
TZ=America/Regina
