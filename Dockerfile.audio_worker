FROM pytorch/pytorch:2.1.2-cuda12.1-cudnn8-runtime

WORKDIR /app

# Install system dependencies
# ffmpeg: required for audio processing (demucs, librosa)
# libsndfile1: required for soundfile
# git: required for some pip packages or cloning
RUN apt-get update && apt-get install -y \
    git \
    ffmpeg \
    libsndfile1 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements from parent context
COPY requirements.txt .

# Install Python dependencies
# Note: The base image already contains PyTorch, but we install from requirements
# to ensure other deps (FastAPI, Demucs, etc.) are present.
RUN pip install --no-cache-dir -r requirements.txt

# Copy audio worker source code
COPY audio_worker/ .

# Expose the API port
EXPOSE 8000

# Start the FastAPI server
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
